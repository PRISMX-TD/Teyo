# 复制为 .env.local 后填写。Next.js 会自动读 .env.local；vitest.config.mts
# 与 scripts/*.mjs 也显式读它。

# Supabase 项目（浏览器与中间件都会用到 URL 与 anon key）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只在服务端用：收据存储的签名 URL（lib/supabase/storage.ts）与
# scripts/dev-session-cookie.mjs。绝不能加 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=

# 直连 Postgres 串（应用的 repository、迁移脚本与 db 集成测试都用它）。
# 密码里的 # 必须写成 %23，否则 URI 解析时 # 之后会被当成 fragment 丢掉。
DATABASE_URL=

# /api/cron/exchange-rates 的 Bearer 密钥；Vercel Cron 会自动带上同名变量。
# 未配置时该路由返回 500 拒绝，而不是放行。
CRON_SECRET=

# 可选：站点的绝对地址，用作 metadataBase（app/layout.tsx）。
# 不填时在 Vercel 上回退到 VERCEL_URL，本地回退到 http://localhost:3000。
NEXT_PUBLIC_SITE_URL=
